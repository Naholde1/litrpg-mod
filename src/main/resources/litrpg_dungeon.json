,4105,62,-277],"period":70,"dmg":0.22,"near":[4087,60,-290,4105,66,-269],"id":"s4_flameX","type":"flames"},{"buttons":[[4087,61,-285]],"opens":["s4_secret"],"xp":true,"solved":"Тайный лаз открыт!","id":"s4_secretbtn","type":"switch"}],"caches":[[4072,60,-281,2],[4103,60,-289,1]],"lore":[{"box":[4080,59,-66,4112,68,-13],"title":"Литейный цех","text":"Огнемёты бьют по очереди — то слева, то справа. Следите за искрами на полу."},{"box":[4094,59,-97,4098,65,-67],"title":"Коридор прессов","text":"Прессы бьют волной — проскакивайте сразу за ударом."},{"box":[4078,59,-132,4114,70,-98],"title":"Плавильня","text":"Голем раскаляется. Танк — заведите его в закалочную купель, пока жар не сжёг группу."},{"box":[4074,56,-187,4118,70,-143],"title":"Лавовая река","text":"Плиты моста поднимаются из лавы волной. Упавший сгорит и вернётся на берег — израненным."},{"box":[4076,59,-258,4116,72,-218],"title":"Горнило близнецов","text":"Игнис и Синдер сильнее рядом друг с другом. Держите их порознь и не пересекайте огненную нить между ними."},{"box":[4074,59,-350,4118,74,-307],"title":"Трон Повелителя Пепла","text":"Под полом — лава. Повелитель рушит плиты; когда пол кончится — он утянет вас в кальдеру."}],"music":"forges"},{"n":5,"key":"spire","name":"Шпиль Бездны","sub":"Отсюда не возвращаются — отсюда выходят","lvl":[40,50],"box":[5040,10,-376,5200,120,22],"camp":[5120,64,9,180],"trader":[5115,64,3,135],"exit":[5119,72,-364,5121,75,-363],"packs":[{"id":"s5_false","at":[5162,60,-99],"r":4,"mobs":[{"type":"minecraft:enderman","at":[5160,60,-99],"lvl":44,"rank":"ELITE"},{"type":"litrpg:banshee","at":[5164,60,-98],"lvl":44}],"ambush":true},{"id":"s5_b1","at":[5106,60,-36],"r":10,"mobs":[{"type":"minecraft:enderman","at":[5104,60,-36],"lvl":40},{"type":"minecraft:enderman","at":[5108,60,-38],"lvl":40},{"type":"litrpg:banshee","at":[5106,60,-33],"lvl":41}]},{"id":"s5_b2","at":[5130,60,-50],"r":10,"mobs":[{"type":"litrpg:demon_stalker","at":[5128,60,-50],"lvl":41},{"type":"litrpg:demon_stalke