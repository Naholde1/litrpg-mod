:"portal"},{"dials":[[5116,61,-114],[5120,61,-114],[5124,61,-114]],"answer":[5,2,4],"start":[0,0,0],"opens":["s5_dialgate"],"xp":true,"solved":"Знаки сошлись — Часовой зал открыт","id":"s5_dials","type":"dials"},{"box":[5118,60,-172,5122,62,-170],"axis":"x","period":46,"near":[5118,60,-175,5122,66,-167],"id":"s5_blades","type":"blades"}],"caches":[[5146,60,-30,2],[5133,60,-204,1]],"lore":[{"box":[5088,58,-85,5152,70,-13],"title":"Мост над Бездной","text":"Внизу — пустота. Упавшего Бездна вернёт на край — но ранит. Мост между вторым и третьим островом осыпается."},{"box":[5108,59,-114,5132,68,-94],"title":"Зал Порталов","text":"Четыре разлома ведут в видения. Три хранят знаки, одно — лжёт. Выставьте знаки на дисках по порядку."},{"box":[5099,59,-166,5141,72,-124],"title":"Часовой зал","text":"Хронофаг откатывает время. Разбейте песочные часы, пока он читает «Откат», — иначе он вернёт себе здоровье."},{"box":[5105,59,-206,5135,70,-176],"title":"Сад парящих камней","text":"Здесь камни забыли, что умеют падать."},{"box":[5102,59,-249,5138,70,-215],"title":"Пасть Пожирателя","text":"Пожиратель глотает целые миры — и вас вместе с ними. Во льду держитесь у костров, в огне — не стойте у лавы."},{"box":[5096,70,-324,5144,86,-276],"title":"Вершина Шпиля","text":"Площадка над пустотой. Ксал'Атар рушит её края и сталкивает вниз. Последний бой — в Сердце Бездны."}],"music":"spire"}],"lobby":{"spawn":[0,64,8,180],"box":[-20,60,-44,20,88,20],"start":[-4,63,-37,4,67,-31],"gates":[],"lore":[{"box":[-16,62,-16,16,74,16],"title":"Преддверие","text":"Система: «Собери группу и встань на печать у Врат. Дороги назад не будет.»"}]}}